# Conexión PostgreSQL clínica (Neon en la configuración actual)
PG_CONNECTION_STRING=postgresql://usuario:password@host:5432/database?sslmode=require

# JWT
JWT_SECRET_KEY=CAMBIAR_POR_UN_SECRETO_SEGURO
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# FHIR / rest-hook R21
HAPI_FHIR_URL=http://hapi-fhir:8080/fhir
FHIR_HOOK_URL=http://api:8000/fhir-hook
FHIR_HOOK_TOKEN=CAMBIAR_POR_TOKEN_SEGURO

# Servicio ML / seudonimización
ML_URL=http://ml:8001
ML_SERVICE_TOKEN=CAMBIAR_POR_TOKEN_SEGURO
SEUDONIMO_SECRETO=CAMBIAR_POR_SECRETO_SEGURO
ALERTA_ESCALAR_MINUTOS=5

# Mongo (Docker Compose la sobrescribe con el servicio mongodb)
MONGO_CONNECTION_STRING=mongodb://mongodb:27017/triaje
